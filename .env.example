# Server-only OpenAI-compatible configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
MAX_STEPS=100
ADB_PATH=adb
HOST=127.0.0.1
PORT=3000
DEVICE_REFRESH_MS=3000
SCREEN_REFRESH_MS=900
# gplv3 | clean-room | snapshot
SCRCPY_INTEGRATION=gplv3

# Durable run-event history retention
EVENT_RETENTION_DAYS=30

# Keep false unless TLS/auth/device authorization are added
ALLOW_LAN=false

# Only enable behind a controlled reverse proxy
TRUST_PROXY=false

SCHEDULE_RETENTION_DAYS=365
