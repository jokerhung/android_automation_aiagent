{
  "name": "android-vision-control",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server.ts",
    "build": "next build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "preflight": "tsx scripts/preflight.ts",
    "test:watch": "vitest",
    "scrcpy:check": "tsx scripts/check-scrcpy-decision.ts",
    "verify:device": "tsx scripts/verify-device.ts",
    "verify:release": "npm run preflight && npm run typecheck && npm test && npm run build && npm audit --omit=dev && npm run verify:device && npm run scrcpy:check",
    "verify:scrcpy-ui": "node scripts/smoke-scrcpy-ui.cjs",
    "verify:keyboard-isolation": "node scripts/verify-chat-keyboard-isolation.cjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.11",
    "better-sqlite3": "^13.0.3",
    "next": "^15.5.7",
    "openai": "^6.8.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "ws": "^8.18.3",
    "zod": "^3.25.76",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "postcss": "^8.5.26"
  }
}
